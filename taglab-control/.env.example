# Use um banco exclusivo desta aplicação. Nunca publique estes valores no TagLab.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/taglab_control?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/taglab_control/auth
NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
APP_ORIGIN=http://localhost:3000
TAGLAB_ORIGINS=https://simuladorgtm-taglab-vercel.vercel.app
# E-mail do primeiro administrador. Ele precisa verificar o endereço no login.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
