{
  "name": "taglab-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Central editorial e API de conteúdo do TagLab",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.mjs"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.2",
    "playwright": "1.62.1"
  }
}
